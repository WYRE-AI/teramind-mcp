# Teramind Access Token (JWT, generated in the Teramind dashboard ->
# Administrator/User menu -> Access Tokens). Passed to Teramind's API in the
# x-access-token header.
#
# IMPORTANT (see README's "Credential scope" section): a token inherits the
# FULL permissions of whichever account created it. By default (a single
# Administrator account, the common case for a fresh self-serve trial) a
# token can reach every endpoint in Teramind's API, including screen
# recordings, keystroke logs, and email/chat content capture - this
# connector's own code never calls those endpoints, but the credential
# itself is not restricted unless you deliberately create the token under a
# reduced-privilege account (Operational Administrator - see README).
TERAMIND_ACCESS_TOKEN=

# Per-instance Teramind API base URL, e.g. https://yourcompany.teramind.co
# (cloud) or your on-premise dashboard's URL. Teramind's API is scoped per
# customer instance - there is no shared multi-tenant base URL.
TERAMIND_INSTANCE_URL=

# stdio (default) or http
# MCP_TRANSPORT=stdio

# Credential source for HTTP: env (process environment) or gateway (required
# X-Teramind-Access-Token and X-Teramind-Instance-Url headers; no env
# fallback). The container image and Compose service set gateway. Stdio
# ignores this and reads TERAMIND_* from the environment.
# AUTH_MODE=env

# Required to start the HTTP transport. The process logs an error and exits
# non-zero when this is empty or a known placeholder (changeme, placeholder,
# your-s2s-secret, secret, password, test, an unresolved ${...} template, and
# similar stand-ins). Value is the gateway-provisioned service-to-service
# secret. Never commit a real secret. The value is never logged.
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without
# CONDUIT_S2S_SECRET. The server logs a warning, does not check X-Gateway-S2S,
# and binds 127.0.0.1 only. A non-loopback MCP_HTTP_HOST (including 0.0.0.0,
# localhost, and ::1) is ignored in that mode and the override is logged. A
# known placeholder secret still refuses to start.
# MCP_ALLOW_INSECURE_DEV=1

# Bind address when a real CONDUIT_S2S_SECRET is set. Unset keeps 0.0.0.0 so
# container deploys are unchanged. The image and Compose set 0.0.0.0 inside
# the container and publish the host port on 127.0.0.1. Without a usable
# secret, MCP_ALLOW_INSECURE_DEV=1 ignores this and binds 127.0.0.1 only.
# MCP_HTTP_HOST=0.0.0.0
# MCP_HTTP_PORT=8080
